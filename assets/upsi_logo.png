  font-size: 0.85rem;
  margin-bottom: 12px;
}
.epena-feature .epena-meta .date {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #555;
}
.epena-feature .epena-meta .category {
  background-color: #c5374e;
  color: white;
  padding: 2px 10px;
  border-radius: 4px;
  font-size: 0.75rem;
}
.epena-feature h3 {
  font-size: 1.3rem;
  margin: 0 0 10px;
  font-weight: 500;
}
.epena-feature h3 a {
  text-decoration: none;
  color: #195FAD;
}
.epena-feature p {
  font-size: 0.95rem;
  color: #444;
}

/* Right Post List */
.epena-right {
  flex: 1 1 40%;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.epena-card {
  background: white;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  padding: 12px;
  border-radius: 6px;
  transition: transform 0.3s;
  color: #195FAD;
}
.epena-card:hover {
  transform: translateX(6px);
}
.epena-card img {
  width: 180px;
  height: 120px;
  object-fit: cover;
  flex-shrink: 0;
  border-radius: 4px;
}
.epena-card-content {
  flex: 1;
}
.epena-card-content h4 {
  margin: 0 0 6px;
  font-size: 1rem;
  font-weight: 500;
}
.epena-card-content h4 a {
  text-decoration: none;
  color: #195FAD;
}
.epena-card-content .meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.75rem;
}
.epena-card-content .meta .date {
  display: flex;
  align-items: center;
  gap: 4px;
  color: #666;
}
.epena-card-content .meta .category {
  background-color: #c5374e;
  color: white;
  padding: 2px 8px;
  border-radius: 4px;
}
.epena-card .arrow {
  font-size: 1.25rem;
  color: #c5374e;
  margin-left: auto;
}
@media (max-width: 768px) {
  .epena-wrapper {
    flex-direction: column;
  }
  .epena-card {
    flex-direction: column;
    align-items: flex-start;
  }
  .epena-card img {
    width: 100%;
    height: auto;
  }
  .epena-card .arrow {
    display: none;
  }
}
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div id="epena-news" class="epena-wrapper"></div>

<script>
<div class="epena-wrapper">
  <?php if ($maxitems == 0) : ?>
    <p>No posts found.</p>
  <?php else : ?>
    <?php $i = 0; foreach ( $rss_items as $item ) : ?>
      <?php if ($i == 0): // FEATURED POST ?>
        <div class="epena-feature">
          <a href="<?php echo esc_url( $item->get_permalink() ); ?>" target="_blank">
            <?php
              // try to get image from content
              $content = $item->get_content();
              preg_match('/<img.*?src=["'](.*?)["']/', $content, $matches);
              $img = $matches[1] ?? 'https://yourdomain.com/no-image-635x360.png';
            ?>
            <img decoding="async" src="<?php echo esc_url($img); ?>" alt="<?php echo esc_attr($item->get_title()); ?>">
          </a>
          <div class="epena-content">
            <div class="epena-meta">
              <div class="date"><i class="bi bi-calendar"></i> <?php echo $item->get_date('j M Y'); ?></div>
              <div class="category">
                <?php echo esc_html( $item->get_category() ? $item->get_category()->get_label() : 'News' ); ?>
              </div>
            </div>
            <h3><a href="<?php echo esc_url( $item->get_permalink() ); ?>" target="_blank">
              <?php echo esc_html( $item->get_title() ); ?>
            </a></h3>
            <p><?php echo wp_trim_words( wp_strip_all_tags($content), 30, '...' ); ?></p>
          </div>
        </div>
        <div class="epena-right">
      <?php else: // RIGHT SIDE POSTS ?>
        <div class="epena-card">
          <a href="<?php echo esc_url( $item->get_permalink() ); ?>" target="_blank" style="display:flex; align-items:center; gap:16px; text-decoration:none; color:inherit;">
            <?php
              $content = $item->get_content();
              preg_match('/<img.*?src=["'](.*?)["']/', $content, $matches);
              $img = $matches[1] ?? 'https://yourdomain.com/no-image-180x120.png';
            ?>
            <img decoding="async" src="<?php echo esc_url($img); ?>" alt="<?php echo esc_attr($item->get_title()); ?>">
            <div class="epena-card-content">
              <h4><?php echo esc_html( $item->get_title() ); ?></h4>
              <div class="meta">
                <div class="date"><i class="bi bi-calendar"></i> <?php echo $item->get_date('j M Y'); ?></div>
                <div class="category">
                  <?php echo esc_html( $item->get_category() ? $item->get_category()->get_label() : 'News' ); ?>
                </div>
              </div>
            </div>
            <div class="arrow">&rarr;</div>
          </a>
        </div>
      <?php endif; ?>
    <?php $i++; endforeach; ?>
    </div><!-- .epena-right -->
  <?php endif; ?>
</div>
</script>
</div>
