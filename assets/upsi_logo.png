<div class="uabb-module-content uabb-flip-box-wrap">
	<div class="uabb-flip-box  horizontal_flip_left uabb-custom-height">
		<div class="uabb-flip-box uabb-flip-box-outter">
			<div class="uabb-face uabb-front ">
				<div class="uabb-flip-box-section uabb-flip-box-section-vertical-middle">
					<div class="uabb-module-content uabb-imgicon-wrap">				<span class="uabb-icon-wrap">
			<span class="uabb-icon">
			<i class="dashicons dashicons-before dashicons-warning" aria-hidden="true"></i>
			</span>
		</span>
	
		</div>										<h2 class="uabb-face-text-title">Disclaimer</h2>
										</div>
			</div><!-- END .front -->
			<div class="uabb-face uabb-back">
				<div class="uabb-flip-box-section uabb-flip-box-section-vertical-middle">
										<div class="uabb-back-flip-box-section-content uabb-text-editor">
						<p>Universiti Pendidikan Sultan Idris is not liable for any loss or damage caused by the usage of any information obtained from this web site.</p>					</div>
