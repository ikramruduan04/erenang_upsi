	<style>

.epena-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  justify-content: center;
  align-items: stretch;
  font-family: 'Segoe UI', sans-serif;
}

.epena-feature {
  flex: 1 1 55%;
  background: white;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  transition: transform 0.3s;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  color: #195FAD;
  max-height: 100%;
}
.epena-feature:hover {
  transform: translateY(-5px);
}
.epena-feature img {
  width: 100%;
  height: 360px;
  object-fit: cover;
  object-position: top center;
}
.epena-feature .epena-content {
  padding: 16px;
}
.epena-feature .epena-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
  margin-bottom: 12px;
}
.epena-feature .epena-meta .date {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #555;
}
.epena-feature .epena-meta .category {
  background-color: #c5374e;
  color: white;
  padding: 2px 10px;
  border-radius: 4px;
  font-size: 0.75rem;
}
.epena-feature h3 {
  font-size: 1.3rem;
  margin: 0 0 10px;
  font-weight: 500;
}
.epena-feature h3 a {
  text-decoration: none;
  color: #195FAD;
}
.epena-feature p {
  font-size: 0.95rem;
  color: #444;
}
.epena-feature .read-more {
  display: inline-block;
  color: #c5374e;
  font-weight: bold;
  text-decoration: none;
}
.epena-feature .read-more:hover {
  text-decoration: underline;
}

.epena-right {
  flex: 1 1 40%;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.epena-card {
  background: white;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  padding: 12px;
  border-radius: 6px;
  transition: transform 0.3s;
  color: #195FAD;
}
.epena-card:hover {
  transform: translateX(6px);
}
.epena-card img {
  width: 180px;
  height: 120px;
  object-fit: cover;
  flex-shrink: 0;
  border-radius: 4px;
}
.epena-card-content {
  flex: 1;
}
.epena-card-content h4 {
  margin: 0 0 6px;
  font-size: 1rem;
  font-weight: 500;
}
.epena-card-content h4 a {
  text-decoration: none;
  color: #195FAD;
}
.epena-card-content .meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.75rem;
}
.epena-card-content .meta .date {
  display: flex;
  align-items: center;
  gap: 4px;
  color: #666;
}
.epena-card-content .meta .category {
  background-color: #c5374e;
  color: white;
  padding: 2px 8px;
  border-radius: 4px;
}
.epena-card .arrow {
  font-size: 1.25rem;
  color: #c5374e;
  margin-left: auto;
}
@media (max-width: 768px) {
  .epena-wrapper {
    flex-direction: column;
  }
  .epena-card {
    flex-direction: column;
    align-items: flex-start;
  }
  .epena-card img {
    width: 100%;
    height: auto;
  }
  .epena-card .arrow {
    display: none;
  }
}
</style>

<link rel="stylesheet" href="/wp-content/uploads/assets/bootstrap-icons/bootstrap-icons.css">

<div id="epena-news" class="epena-wrapper"></div>

<script>
function extractFirstImage(html) {
  const tempDiv = document.createElement("div");
  tempDiv.innerHTML = html;

  const wpFeatured = tempDiv.querySelector("img.img-fluid.wp-post-image");
  if (wpFeatured) return wpFeatured.src;

  const img = tempDiv.querySelector("img");
  return img ? img.src : null;
}

function getFeedImage(item) {
  const media = item.getElementsByTagName("media:content")[0];
  if (media?.getAttribute("url")) return media.getAttribute("url");

  const enclosure = item.getElementsByTagName("enclosure")[0];
  if (enclosure?.getAttribute("url")) return enclosure.getAttribute("url");

  const contentEncoded = item.getElementsByTagName("content:encoded")[0]?.textContent || "";
  const description = item.querySelector("description")?.textContent || "";
  return extractFirstImage(contentEncoded) || extractFirstImage(description) || null;
}

function createExcerpt(text, link) {
  const plainText = text.replace(/(<([^>]+)>)/gi, "");
  const excerpt = plainText.length > 1500 ? plainText.substring(0, 1500) + "..." : plainText;
  return `${excerpt} <a href="${link}" target="_blank" class="read-more">Read More</a>`;
}

fetch("/wp-content/uploads/assets/epena-proxy.php?nocache=" + Date.now())
  .then(res => res.text())
  .then(str => new window.DOMParser().parseFromString(str, "text/xml"))
  .then(data => {
    const items = data.querySelectorAll("item");
    const posts = Array.from(items).slice(0, 5);
    const container = document.getElementById("epena-news");

    if (!posts.length) {
      container.innerHTML = "<p>No posts found.</p>";
      return;
    }

    const featured = posts[0];
    const title = featured.querySelector("title").textContent;
    const link = featured.querySelector("link").textContent;
    const pubDate = new Date(featured.querySelector("pubDate").textContent);
    const description = featured.querySelector("description").textContent;
    const category = featured.querySelector("category")?.textContent || "News";
    const featuredImage = getFeedImage(featured) || "/wp-content/uploads/2025/07/no-image-180x120-1.png";

    const featuredHTML = `
      <div class="epena-feature">
        <a href="${link}" target="_blank">
          <img decoding="async" src="${featuredImage}" alt="${title}">
        </a>
        <div class="epena-content">
          <div class="epena-meta">
            <div class="date"><i class="bi bi-calendar"></i> ${pubDate.toLocaleDateString()}</div>
            <div class="category">${category}</div>
          </div>
          <h3><a href="${link}" target="_blank">${title}</a></h3>
          <p>${createExcerpt(description, link)}</p>
        </div>
      </div>
    `;
    container.insertAdjacentHTML("beforeend", featuredHTML);

    const rightWrapper = document.createElement("div");
    rightWrapper.className = "epena-right";

    posts.slice(1).forEach(post => {
      const title = post.querySelector("title").textContent;
      const link = post.querySelector("link").textContent;
      const pubDate = new Date(post.querySelector("pubDate").textContent);
      const description = post.querySelector("description").textContent;
      const category = post.querySelector("category")?.textContent || "News";
      const image = getFeedImage(post) || "/wp-content/uploads/2025/07/no-image-635x360-1.png";

      const card = document.createElement("div");
      card.className = "epena-card";

      card.innerHTML = `
        <a href="${link}" target="_blank" style="display:flex; align-items:center; gap:16px; text-decoration:none; color:inherit;">
          <img decoding="async" src="${image}" alt="${title}">
          <div class="epena-card-content">
            <h4><a href="${link}" target="_blank">${title}</a></h4>
            <div class="meta">
              <div class="date"><i class="bi bi-calendar"></i> ${pubDate.toLocaleDateString()}</div>
              <div class="category">${category}</div>
            </div>
          </div>
          <div class="arrow">&rarr;</div>
        </a>
      `;
      rightWrapper.appendChild(card);
    });

    container.appendChild(rightWrapper);
  })
  .catch(() => {
    document.getElementById("epena-news").innerHTML = "<p>Unable to load news from ePena.</p>";
  });
</script></div>
<div  class="fl-module fl-module-html fl-html fl-node-5nvl63ah2yod fl-animation fl-fade-up" data-node="5nvl63ah2yod" data-animation-delay="0" data-animation-duration="1">
